From b3e465621ebf5bda40d69c5a602b387b3f8eda60 Mon Sep 17 00:00:00 2001
From: "Christoph Engelbert (noctarius)" <chris@simplyblock.io>
Date: Thu, 8 Oct 2026 15:48:03 +0200
Subject: [PATCH] nfsd: fence SCSI registrations left by an earlier server
 instance

A pNFS SCSI client registers the reservation key it is given on the
first GETDEVICEINFO, and the key carries the server's boot time. After
a server restart every client is given a new key, but on NVMe its old
registration is still on the namespace: the client's pr_register(key,
0) on releasing the device maps to a Replace with a zero key rather than
an Unregister, and a host that is still registered cannot Register
again. The new registration fails, the client marks the device
unavailable without a message, and its I/O goes through the server.

Seen on a restarted server: every registrant on the namespaces carried
a key from the previous boot, none from the current one.

When the server registers and reserves the device for a GETDEVICEINFO,
read the registered keys and preempt every one that is neither the
server's own nor from this boot. Those clients have no state on this
server, so fencing them is what the restart means; it unregisters their
hosts, and each can register its new key.
---
 fs/nfsd/blocklayout.c | 57 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/fs/nfsd/blocklayout.c b/fs/nfsd/blocklayout.c
index e9512c3..5aa8d7b 100644
--- a/fs/nfsd/blocklayout.c
+++ b/fs/nfsd/blocklayout.c
@@ -227,6 +227,62 @@ static u64 nfsd4_scsi_pr_key(struct nfs4_client *clp)
 	return ((u64)clp->cl_clientid.cl_boot << 32) | clp->cl_clientid.cl_id;
 }
 
+/*
+ * Fence the registrations clients of an earlier server instance left on the
+ * device.
+ *
+ * A client registers the key it is given on the first GETDEVICEINFO, and the
+ * key carries the server's boot time. After a restart every client is given a
+ * new key, but on NVMe its old registration is still there: the client's
+ * pr_register(old_key, 0) on releasing the device is a Replace with a zero key
+ * rather than an Unregister, and a host that is still registered cannot
+ * Register again. Its new registration fails, the client marks the device
+ * unavailable, and every byte it moves goes through the server.
+ *
+ * Keys from an earlier boot belong to clients this server has no state for,
+ * so their layouts are gone and fencing them is what a restart means anyway.
+ * Preempting them unregisters those hosts, and each registers its new key.
+ */
+static void
+nfsd4_scsi_fence_stale_keys(struct block_device *bdev,
+		const struct pr_ops *ops, u32 boot)
+{
+	struct pr_keys *keys = NULL;
+	u32 size = 16, i;
+	int ret;
+
+	if (!ops->pr_read_keys || !ops->pr_preempt)
+		return;
+
+	for (;;) {
+		kfree(keys);
+		keys = kzalloc(struct_size(keys, keys, size), GFP_KERNEL);
+		if (!keys)
+			return;
+		keys->num_keys = size;
+		ret = ops->pr_read_keys(bdev, keys);
+		if (ret)
+			goto out;
+		if (keys->num_keys <= size)
+			break;
+		size = keys->num_keys;
+	}
+
+	for (i = 0; i < keys->num_keys; i++) {
+		u64 key = keys->keys[i];
+
+		if (!key || key == NFSD_MDS_PR_KEY || (u32)(key >> 32) == boot)
+			continue;
+		ret = ops->pr_preempt(bdev, NFSD_MDS_PR_KEY, key,
+				PR_EXCLUSIVE_ACCESS_REG_ONLY, true);
+		if (ret)
+			pr_warn("pNFS: failed to fence stale key 0x%llx on %pg: %d\n",
+				key, bdev, ret);
+	}
+out:
+	kfree(keys);
+}
+
 static const u8 designator_types[] = {
 	PS_DESIGNATOR_EUI64,
 	PS_DESIGNATOR_NAA,
@@ -300,6 +356,7 @@ nfsd4_block_get_device_info_scsi(struct super_block *sb,
 		goto out_free_dev;
 	}
 
+	nfsd4_scsi_fence_stale_keys(sb->s_bdev, ops, clp->cl_clientid.cl_boot);
 	return 0;
 
 out_free_dev:
